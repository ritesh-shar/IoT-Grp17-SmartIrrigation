PORT=3000
# Backend runs on the laptop; Docker publishes Mosquitto on localhost:1883.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=change_this_backend_password

# Must match the credentials provisioned for the ESP32 in scripts/setup.ps1.
DEVICE_ID=esp32_soil_001
DEVICE_MQTT_PASSWORD=change_this_device_password

# PostgreSQL runs in Docker and is published on localhost:5432.
DB_PASSWORD=change_this_db_password
DATABASE_URL=postgresql://irrigation:change_this_db_password@127.0.0.1:5432/irrigation
CORS_ORIGIN=http://localhost:5173
